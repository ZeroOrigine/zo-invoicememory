# ============================================================================
# InvoiceMemory — environment variables (FINAL CANONICAL — validation pass 4
# re-assert; the landing step's copy dropped the four STRIPE_PRICE_* variables
# AGAIN, which would ship a production checkout with no prices).
# NEXT_PUBLIC_* variables are bundled into the browser. Everything else is
# SERVER-ONLY and must never get the NEXT_PUBLIC_ prefix.
# Deploy Mind: set ALL of these on Netlify as NON-SECRET vars (secret-scoped
# vars are invisible during `next build`). Verify every one BEFORE deploying.
# ============================================================================

# --- App URL (REQUIRED) -----------------------------------------------------
# Production: https://invoicememory.zeroorigine.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (REQUIRED) — from zo_config ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY. Bypasses RLS. Used exclusively by Stripe webhook handlers.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (REQUIRED) — TEST keys first, from zo_config ----------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# SERVER-ONLY.
STRIPE_SECRET_KEY=
# SERVER-ONLY. Signing secret of this product's webhook endpoint.
STRIPE_WEBHOOK_SECRET=

# --- Stripe Price IDs (REQUIRED, SERVER-ONLY) --------------------------------
# THE canonical convention read by lib/stripe/checkout.ts. The retired
# STRIPE_PRICE_ID_* names must NOT be used.
# Pro: $29/mo, $290/yr. Business: $99/mo, $990/yr. NO trials configured —
# upgrade buttons must say "Upgrade — $X/mo", never "Start free trial".
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
